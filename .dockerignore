# Git e GitHub
.git
.github
.gitignore

# Ambientes virtuais e cache
__pycache__/
.pytest_cache/
.tox/
.ruff_cache/
.venv/
.agents/

# Logs e arquivos Markdown
*.log
*.md
lista_ordenada_de_comandos_bash.txt

# Pastas que a API não usa em produção
notebooks/
helm/
tests/
scripts/
data/

# Artefatos gerados
*.png
*.jpg
*.csv
*.sqlite
# Referência canônica necessária para inferência (nenhum dataset operacional).
!data/
data/*
!data/reference/
data/reference/*
!data/reference/bahia_wind_capacity_checkpoints.csv
