# ==========================================
# RustFS / Data Lake
# ==========================================
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_BUCKET=energy-lake
RUSTFS_ROOT_USER=insira_seu_usuario_aqui
RUSTFS_ROOT_PASSWORD=insira_sua_senha_aqui

# ==========================================
# MLflow Tracking Server
# ==========================================
MLFLOW_TRACKING_URI=http://localhost:5000

# ==========================================
# Model Serving / Dashboard
# ==========================================
API_URL=http://localhost:8000
API_RELOAD_URL=http://localhost:8000/reload-model

# ==========================================
# Prefect Orchestrator
# ==========================================
PREFECT_API_URL=http://127.0.0.1:4200/api

# ==========================================
# PostgreSQL
# Used by the MLflow backend when running PostgreSQL directly.
# In the Helm/Kubernetes setup, credentials are managed separately
# through the ignored helm/values_secrets.yaml file.
# ==========================================
POSTGRES_USER=insira_o_usuario_do_banco
POSTGRES_PASSWORD=insira_a_senha_do_banco
POSTGRES_DB=nome_do_banco
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
